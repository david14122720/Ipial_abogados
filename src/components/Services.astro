---
import { getCollection } from "astro:content";
// Fuente canónica: Ipialabogados.md §3.1/§3.2/§3.3/§4 — getCollection drives rendering; no hardcode arrays (§6).
const servicios = (await getCollection("servicios")).sort((a, b) => a.data.order - b.data.order);

function parseItems(body: string): string[] {
  return body
    .split("\n")
    .map((l) => l.trim())
    .filter((l) => l.startsWith("- "))
    .map((l) => l.slice(2).trim())
    .filter(Boolean);
}

const byGrupo = new Map(servicios.map((e) => [e.data.grupo, { entry: e, items: parseItems(e.body ?? "") }]));
const trabajadores = byGrupo.get("trabajadores");
const empleadores = byGrupo.get("empleadores");
const pensionados = byGrupo.get("pensionados");
const penal = byGrupo.get("penal");

const omarGrupos = [trabajadores, empleadores, pensionados].filter(Boolean) as NonNullable<typeof trabajadores>[];
---

<section id="servicios" class="py-section-gap px-gutter bg-surface">
  <div class="max-w-container-max mx-auto">
    <div class="text-center mb-16">
      <h2 class="text-headline-lg text-primary">Servicios Jurídicos Especializados</h2>
    </div>

    <div class="services-board">
      <!-- Omar Enrique Ipial Ipial — Laboral y Seguridad Social §3 -->
      <div data-abogado="omar" class="mb-16">
        <div class="flex flex-col md:flex-row md:items-baseline gap-2 mb-8 border-b border-silver-metallic pb-4">
          <h3 class="text-headline-md text-primary">Omar Enrique Ipial Ipial</h3>
          <p class="text-label-sm font-semibold text-primary tracking-widest uppercase">Especialista en Derecho Laboral y Seguridad Social</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          {omarGrupos.map((g) => {
            const grupo = g.entry.data.grupo;
            const title = g.entry.data.title;
            const items = g.items;
            const first = items.slice(0, 6);
            const rest = items.slice(6);
            const hasMore = rest.length > 0;
            return (
              <div data-grupo={grupo} data-abogado="omar" class="card-lex bg-surface-container-low p-6 rounded-lg border border-outline-variant flex flex-col hover:shadow-[0_10px_30px_rgba(20,99,77,0.08)] transition-shadow">
                <h4 class="text-headline-md text-primary mb-4">{title}</h4>
                <ul class="space-y-0">
                  {first.map((item) => (
                    <li class="text-[14px] leading-6 text-on-surface border-b border-silver-metallic/60 py-2">{item}</li>
                  ))}
                </ul>
                {hasMore && (
                  <>
                    <div id={`grupo-${grupo}`} class="grupo-extra">
                      <ul class="space-y-0 mt-0">
                        {rest.map((item) => (
                          <li class="text-[14px] leading-6 text-on-surface border-b border-silver-metallic/60 py-2">{item}</li>
                        ))}
                      </ul>
                    </div>
                    <button data-grupo-toggle aria-expanded="false" aria-controls={`grupo-${grupo}`} class="mt-4 text-xs font-semibold text-primary hover:text-emerald-deep transition-colors duration-200 uppercase tracking-wider self-start focus-visible:outline-2 focus-visible:outline-emerald-deep focus-visible:outline-offset-2">
                      Leer más
                    </button>
                  </>
                )}
              </div>
            );
          })}
        </div>
      </div>

      <!-- Franco Miller Ipial Ipial — Penal §4 -->
      {penal && (
        <div data-abogado="franco" class="mt-16">
          <div class="flex flex-col md:flex-row md:items-baseline gap-2 mb-8 border-b border-silver-metallic pb-4">
            <h3 class="text-headline-md text-primary">Franco Miller Ipial Ipial</h3>
            <p class="text-label-sm font-semibold text-primary tracking-widest uppercase">Especialista en Derecho Penal y Procesal Penal</p>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <div data-grupo="penal" data-abogado="franco" class="card-lex bg-surface-container-low p-6 rounded-lg border border-outline-variant flex flex-col hover:shadow-[0_10px_30px_rgba(20,99,77,0.08)] transition-shadow">
              <h4 class="text-headline-md text-primary mb-4">{penal.entry.data.title}</h4>
              <ul class="space-y-0">
                {penal.items.map((item) => (
                  <li class="text-[14px] leading-6 text-on-surface border-b border-silver-metallic/60 py-2">{item}</li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      )}
    </div>
  </div>
</section>

<script>
  (() => {
    const toggles = document.querySelectorAll("[data-grupo-toggle]");
    toggles.forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = btn.getAttribute("aria-controls");
        const panel = id ? document.getElementById(id) : null;
        const expanded = btn.getAttribute("aria-expanded") === "true";
        btn.setAttribute("aria-expanded", String(!expanded));
        if (panel) panel.classList.toggle("is-expanded", !expanded);
        btn.textContent = expanded ? "Leer más" : "Leer menos";
      });
    });
  })();
</script>
