---
import { getCollection } from "astro:content";
import ServiceExplorer from "./islands/ServiceExplorer.tsx";
const servicios = (await getCollection("servicios")).sort((a, b) => a.data.order - b.data.order);

function parseItems(body: string): string[] {
  return body.split("\n").map((l) => l.trim()).filter((l) => l.startsWith("- ")).map((l) => l.slice(2).trim()).filter(Boolean);
}

const byGrupo = new Map(servicios.map((e) => [e.data.grupo, { entry: e, items: parseItems(e.body ?? "") }]));
const grupos = [
  byGrupo.get("trabajadores"),
  byGrupo.get("empleadores"),
  byGrupo.get("pensionados"),
  byGrupo.get("penal"),
].filter(Boolean).map((g) => ({ grupo: g!.entry.data.grupo, title: g!.entry.data.title, items: g!.items }));
---

<section id="servicios" class="py-section-gap px-gutter bg-surface">
  <div class="max-w-container-max mx-auto">
    <div class="text-center mb-12">
      <p class="text-label-sm font-semibold tracking-widest uppercase text-primary mb-2">Servicios Jurídicos</p>
      <h2 class="text-headline-lg text-primary">Servicios Jurídicos Especializados</h2>
      <div class="w-20 h-px bg-silver-metallic mx-auto mt-4"></div>
    </div>
    <ServiceExplorer grupos={grupos} client:visible />
  </div>
</section>
