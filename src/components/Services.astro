---
// Fuente: Ipialabogados.md §3.1/§3.2/§3.3/§4 — fuente canónica, transcripción verbatim §6. No invención.
const omarTrabajadores = [
  "Derechos de petición.", // §3.1
  "Acciones de tutela.", // §3.1
  "Conciliaciones laborales.", // §3.1
  "Representación y asesoría en procesos disciplinarios.", // §3.1
  "Trámites pensionales.", // §3.1
  "Revisión y liquidación de prestaciones sociales.", // §3.1
  "Cobro de incapacidades ante entidades de seguridad social.", // §3.1
  "Demandas y tutelas por fueros de estabilidad laboral reforzada.", // §3.1
  "Demandas por accidentes o enfermedades laborales.", // §3.1
  "Demandas laborales por violación al fuero sindical y circunstancial.", // §3.1
  "Demandas laborales por contrato realidad.", // §3.1
  "Demandas por no pago de prestaciones sociales.", // §3.1
  "Demandas por despidos sin justa causa.", // §3.1
] as const; // §3.1 Servicios para trabajadores

const omarEmpleadores = [
  "Asesoría en pensiones.", // §3.2
  "Asesoría en seguridad social.", // §3.2
  "Asesoría en derecho laboral.", // §3.2
  "Asesoría en vinculaciones laborales.", // §3.2
  "Asesoría en desvinculaciones laborales.", // §3.2
  "Elaboración y asesoría sobre contratos laborales.", // §3.2
  "Reglamentos internos de trabajo.", // §3.2
  "Asesoría en procesos disciplinarios.", // §3.2
  "Asesoría en manejo de incapacidades.", // §3.2
  "Asesoría en trabajadores con fueros de estabilidad laboral reforzada.", // §3.2
  "Representación y defensa en procesos judiciales.", // §3.2
  "Capacitaciones y actualización en la normatividad laboral.", // §3.2
] as const; // §3.2 Servicios para empleadores

const omarPensionados = [
  "Reliquidaciones pensionales.", // §3.3
  "Estudios pensionales.", // §3.3
  "Cálculos actuariales.", // §3.3
  "Asesoría y trámite para reconocimiento de pensión de vejez.", // §3.3
  "Asesoría y trámite para reconocimiento de pensión de sobrevivientes.", // §3.3
  "Asesoría y trámite para reconocimiento de pensión de invalidez.", // §3.3
  "Sustituciones pensionales.", // §3.3
  "Devolución de aportes.", // §3.3
  "Demandas por ineficacia del traslado.", // §3.3
  "Demandas para el reconocimiento de pensiones.", // §3.3
] as const; // §3.3 Servicios para pensionados

const francoPenal = [
  "Representación judicial y asesoría en asuntos y procesos penales.", // §4
  "Defensa y representación en audiencias preliminares.", // §4
  "Defensa y representación en audiencias de juicio oral.", // §4
  "Sustitución de medidas de aseguramiento.", // §4
  "Trámite para obtener libertad condicional.", // §4
  "Trámite para obtener prisión domiciliaria.", // §4
  "Devolución provisional de vehículos.", // §4
  "Devolución definitiva de vehículos.", // §4
  "Traslados a resguardos indígenas.", // §4
  "Representación de víctimas.", // §4
] as const; // §4 Servicios de Derecho Penal y Procesal Penal
---
<section id="servicios" class="py-20" style="background: var(--color-surface-green)">
  <div class="max-w-[1200px] mx-auto px-6 md:px-16">
    <div class="text-center mb-10">
      <h2 class="text-[32px] leading-10 font-semibold text-[#1a1c1c] underline-motif underline-motif--center" style="font-family:'Libre Caslon Text',serif">Servicios Jurídicos Especializados</h2>
    </div>

    <div class="services-board">
      <!-- Omar Enrique Ipial Ipial — Laboral y Seguridad Social §3 -->
      <div data-abogado="omar" class="mb-12">
        <h3 class="text-[22px] font-semibold text-[#1a1c1c] mb-1" style="font-family:'Libre Caslon Text',serif">Omar Enrique Ipial Ipial</h3>
        <p class="text-sm font-semibold text-[#005243] tracking-wide mb-6">Especialista en Derecho Laboral y Seguridad Social</p>

        <div data-grupo="trabajadores" class="mb-8">
          <h4 class="text-[18px] font-semibold text-[#1a1c1c] mb-3" style="font-family:'Libre Caslon Text',serif">Para trabajadores</h4>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {omarTrabajadores.slice(0, 6).map((item) => (
              <li class="bg-white border border-[#bec9c4]/30 rounded-lg p-4 border-l-2 border-l-[#005243] text-[14px] leading-6 text-[#1a1c1c]">{item}</li>
            ))}
          </ul>
          <div id="grupo-trabajadores" class="grupo-extra">
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-3">
              {omarTrabajadores.slice(6).map((item) => (
                <li class="bg-white border border-[#bec9c4]/30 rounded-lg p-4 border-l-2 border-l-[#005243] text-[14px] leading-6 text-[#1a1c1c]">{item}</li>
              ))}
            </ul>
          </div>
          <button data-grupo-toggle aria-expanded="false" aria-controls="grupo-trabajadores" class="mt-3 text-sm font-semibold text-[#005243] hover:text-[#1e6b5a] transition-[opacity,transform] duration-200">Leer más</button>
        </div>

        <div data-grupo="empleadores" class="mb-8">
          <h4 class="text-[18px] font-semibold text-[#1a1c1c] mb-3" style="font-family:'Libre Caslon Text',serif">Para empleadores</h4>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {omarEmpleadores.slice(0, 6).map((item) => (
              <li class="bg-white border border-[#bec9c4]/30 rounded-lg p-4 border-l-2 border-l-[#005243] text-[14px] leading-6 text-[#1a1c1c]">{item}</li>
            ))}
          </ul>
          <div id="grupo-empleadores" class="grupo-extra">
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-3">
              {omarEmpleadores.slice(6).map((item) => (
                <li class="bg-white border border-[#bec9c4]/30 rounded-lg p-4 border-l-2 border-l-[#005243] text-[14px] leading-6 text-[#1a1c1c]">{item}</li>
              ))}
            </ul>
          </div>
          <button data-grupo-toggle aria-expanded="false" aria-controls="grupo-empleadores" class="mt-3 text-sm font-semibold text-[#005243] hover:text-[#1e6b5a] transition-[opacity,transform] duration-200">Leer más</button>
        </div>

        <div data-grupo="pensionados" class="mb-2">
          <h4 class="text-[18px] font-semibold text-[#1a1c1c] mb-3" style="font-family:'Libre Caslon Text',serif">Para pensionados</h4>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {omarPensionados.slice(0, 6).map((item) => (
              <li class="bg-white border border-[#bec9c4]/30 rounded-lg p-4 border-l-2 border-l-[#005243] text-[14px] leading-6 text-[#1a1c1c]">{item}</li>
            ))}
          </ul>
          <div id="grupo-pensionados" class="grupo-extra">
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-3">
              {omarPensionados.slice(6).map((item) => (
                <li class="bg-white border border-[#bec9c4]/30 rounded-lg p-4 border-l-2 border-l-[#005243] text-[14px] leading-6 text-[#1a1c1c]">{item}</li>
              ))}
            </ul>
          </div>
          <button data-grupo-toggle aria-expanded="false" aria-controls="grupo-pensionados" class="mt-3 text-sm font-semibold text-[#005243] hover:text-[#1e6b5a] transition-[opacity,transform] duration-200">Leer más</button>
        </div>
      </div>

      <!-- Franco Miller Ipial Ipial — Penal §4 -->
      <div data-abogado="franco">
        <h3 class="text-[22px] font-semibold text-[#1a1c1c] mb-1" style="font-family:'Libre Caslon Text',serif">Franco Miller Ipial Ipial</h3>
        <p class="text-sm font-semibold text-[#005243] tracking-wide mb-4">Especialista en Derecho Penal y Procesal Penal</p>
        <div data-grupo="penal">
          <h4 class="text-[18px] font-semibold text-[#1a1c1c] mb-3" style="font-family:'Libre Caslon Text',serif">Servicios de Derecho Penal</h4>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {francoPenal.map((item) => (
              <li class="bg-white border border-[#bec9c4]/30 rounded-lg p-4 border-l-2 border-l-[#005243] text-[14px] leading-6 text-[#1a1c1c]">{item}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (() => {
    const toggles = document.querySelectorAll('[data-grupo-toggle]');
    toggles.forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('aria-controls');
        const panel = id ? document.getElementById(id) : null;
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!expanded));
        if (panel) panel.classList.toggle('is-expanded', !expanded);
        btn.textContent = expanded ? 'Leer más' : 'Leer menos';
      });
    });
  })();
</script>
