---
const services = [
  { title: "Derecho Civil", desc: "Asesoría integral en contratos, obligaciones, responsabilidad civil y resolución de disputas patrimoniales.", icon: "gavel", col: "" },
  { title: "Familia", desc: "Acompañamiento legal sensible en divorcios, sucesiones, custodia y acuerdos familiares.", icon: "family", col: "" },
  { title: "Laboral", desc: "Defensa de derechos laborales, contratos, seguridad social y conciliaciones obrero-patronales.", icon: "work", col: "" },
  { title: "Administrativo y Disciplinario", desc: "Representación ante entidades del Estado, procesos disciplinarios y defensa en actuaciones administrativas, asegurando el debido proceso y la protección de sus derechos fundamentales.", icon: "account_balance", col: "md:col-span-2" },
  { title: "Penal", desc: "Defensa técnica especializada en procesos penales, con rigor y estricto apego a las garantías constitucionales.", icon: "balance", col: "" },
];
---
<section id="servicios" class="py-20 bg-[#f9f9f9]">
  <div class="max-w-[1200px] mx-auto px-6 md:px-16">
    <div class="text-center mb-10">
      <h2 class="text-[32px] leading-10 font-semibold text-[#1a1c1c] underline-motif underline-motif--center" style="font-family:'Libre Caslon Text',serif">Servicios Jurídicos Especializados</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-10">
      {services.map((s) => (
        <div class={`bg-white border border-[#bec9c4]/30 p-8 rounded-lg hover:shadow-[0_10px_30px_rgba(26,28,28,0.06)] transition-shadow ${s.col}`}>
          <div class="text-[#005243] mb-4">
            {s.icon === "gavel" && <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M14 4l6 6-9 9H5v-6l9-9z"/><path d="M3 21h10"/><path d="M14 4l2-2 6 6-2 2z"/></svg>}
            {s.icon === "family" && <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="7" r="3"/><path d="M8 14c-1 1-1 3 0 4M16 14c1 1 1 3 0 4"/><path d="M12 10v6"/><path d="M7 21h10"/></svg>}
            {s.icon === "work" && <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a4 4 0 0 1 8 0v2"/></svg>}
            {s.icon === "account_balance" && <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 21h18"/><path d="M3 7h18"/><path d="M12 3l9 4H3z"/><path d="M7 7v10M12 7v10M17 7v10"/></svg>}
            {s.icon === "balance" && <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 3v18"/><path d="M3 7l9-4 9 4-9 4z"/><path d="M3 7l4 10h2"/><path d="M17 7l4 10h2"/></svg>}
          </div>
          <h3 class="text-[20px] font-semibold text-[#1a1c1c] mb-2" style="font-family:'Libre Caslon Text',serif">{s.title}</h3>
          <p class="text-[15px] leading-6 text-[#5b5f61]">{s.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
