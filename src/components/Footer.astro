---
import { CONTACT } from "../consts.ts";
---
<footer class="bg-surface-container-highest border-t border-silver-metallic px-gutter py-10">
  <div class="max-w-container-max mx-auto grid md:grid-cols-3 gap-8 items-start text-center md:text-left">
    <!-- Col 1: brand + copyright -->
    <div class="flex flex-col gap-2 items-center md:items-start">
      <a href="#inicio" class="text-[18px] font-bold text-primary">Ipial Abogados</a>
      <p class="label-sm text-secondary">© 2026 Ipial Abogados. Excelencia Jurídica.</p>
      <p class="label-sm text-secondary">{CONTACT.address.full}</p>
    </div>
    <!-- Col 2: social + maps -->
    <div class="flex flex-col gap-3 items-center">
      <p class="label-sm text-on-surface">Síguenos</p>
      <div class="flex gap-4">
        <a href="https://www.facebook.com/" aria-label="Facebook" target="_blank" rel="noopener noreferrer" class="label-sm text-secondary hover:text-primary transition-[transform,opacity] duration-200">Facebook</a>
        <a href="https://www.instagram.com/" aria-label="Instagram" target="_blank" rel="noopener noreferrer" class="label-sm text-secondary hover:text-primary transition-[transform,opacity] duration-200">Instagram</a>
        <a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(CONTACT.address.full)}`} aria-label="Ver en Google Maps" target="_blank" rel="noopener noreferrer" class="label-sm text-secondary hover:text-primary transition-[transform,opacity] duration-200">Maps</a>
      </div>
    </div>
    <!-- Col 3: legal -->
    <div class="flex flex-col gap-3 items-center md:items-end">
      <div class="flex gap-6 label-sm">
        <a href="#" class="text-secondary hover:text-primary transition-[transform,opacity] duration-200">Privacidad</a>
        <a href="#" class="text-secondary hover:text-primary transition-[transform,opacity] duration-200">Términos</a>
        <a href="#contacto" class="text-secondary hover:text-primary transition-[transform,opacity] duration-200">Contacto</a>
      </div>
      <p class="label-sm text-secondary">{CONTACT.horario}</p>
    </div>
  </div>
</footer>
