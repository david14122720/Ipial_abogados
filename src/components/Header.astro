---
import MobileDrawer from "./islands/MobileDrawer.tsx";
---
<nav id="site-header" class="bg-surface/90 backdrop-blur-md text-on-surface border-b border-outline-variant sticky top-0 z-50">
  <div class="flex justify-between items-center w-full px-gutter max-w-container-max mx-auto h-16 md:h-20">
    <a href="#inicio" class="flex items-center gap-3 md:gap-4 min-w-0" aria-label="Ipial Abogados — Inicio">
      <span class="flex flex-col leading-none">
        <span class="font-display-lg text-headline-md text-on-surface font-semibold tracking-tight whitespace-nowrap">Ipial Abogados</span>
        <span class="font-label-md text-label-sm uppercase tracking-[0.18em] text-teal-accent-light mt-1">Firma Jurídica Boutique</span>
      </span>
    </a>
    <div class="hidden md:flex gap-6 lg:gap-8 items-center text-label-md">
      <a class="nav-link text-charcoal-text hover:text-teal-accent-light transition-colors py-2" href="#servicios">Servicios</a>
      <a class="nav-link text-charcoal-text hover:text-teal-accent-light transition-colors py-2" href="#quienes-somos">Quiénes somos</a>
      <a class="nav-link text-charcoal-text hover:text-teal-accent-light transition-colors py-2" href="#abogados">Abogados</a>
      <a class="nav-link text-charcoal-text hover:text-teal-accent-light transition-colors py-2" href="#porque-elegirnos">Por qué elegirnos</a>
      <a class="nav-link text-charcoal-text hover:text-teal-accent-light transition-colors py-2" href="#contacto">Contacto</a>
    </div>
    <MobileDrawer client:media="(max-width: 768px)" />
  </div>
</nav>
