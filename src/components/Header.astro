---
import { Image } from "astro:assets";
import logo from "../assets/logo.webp";
import MobileDrawer from "./islands/MobileDrawer.tsx";
---
<nav class="bg-surface/90 backdrop-blur-md text-forest-deep border-b border-platinum-silver sticky top-0 z-50">
  <div class="flex justify-between items-center w-full px-gutter max-w-container-max mx-auto h-16 md:h-20">
    <a href="#inicio" class="flex items-center gap-3 md:gap-4 min-w-0" aria-label="Ipial Abogados — Inicio">
      <Image src={logo} alt="Ipial Abogados Logo" widths={[120, 180]} sizes="120px" format="webp" quality={80} loading="eager" class="h-10 md:h-12 w-auto object-contain shrink-0" width={180} height={55} />
    </a>
    <div class="hidden md:flex gap-6 lg:gap-8 items-center text-label-md">
      <a class="nav-link text-charcoal-text hover:text-teal-accent transition-colors py-2" href="#servicios">Servicios</a>
      <a class="nav-link text-charcoal-text hover:text-teal-accent transition-colors py-2" href="#quienes-somos">Quiénes somos</a>
      <a class="nav-link text-charcoal-text hover:text-teal-accent transition-colors py-2" href="#abogados">Abogados</a>
      <a class="nav-link text-charcoal-text hover:text-teal-accent transition-colors py-2" href="#porque-elegirnos">Por qué elegirnos</a>
      <a class="nav-link text-charcoal-text hover:text-teal-accent transition-colors py-2" href="#contacto">Contacto</a>
    </div>
    <MobileDrawer client:media="(max-width: 768px)" />
  </div>
</nav>
