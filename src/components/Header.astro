---
import { Image } from "astro:assets";
import logo from "../assets/logo.webp";
import MobileDrawer from "./islands/MobileDrawer.tsx";
---
<header id="site-header" class="fixed top-0 w-full z-50 bg-white/90 backdrop-blur-md shadow-sm border-b border-outline-variant">
  <div class="max-w-[1200px] mx-auto flex justify-between items-center px-6 md:px-10 h-20">
    <a href="#inicio" class="flex items-center gap-2" aria-label="Ipial Abogados — Inicio">
      <Image src={logo} alt="Ipial Abogados" widths={[120, 200]} sizes="120px" format="webp" quality={80} loading="eager" class="h-11 w-auto object-contain" width={200} height={61} />
    </a>
    <nav id="desktop-nav" class="hidden md:flex gap-6 items-center text-[15px]" aria-label="Navegación principal">
      <a href="#inicio" data-nav="inicio" class="text-primary border-b-2 border-primary pb-1 font-semibold">Inicio</a>
      <a href="#nosotros" data-nav="nosotros" class="text-on-surface-variant hover:text-primary transition-colors duration-200">Nosotros</a>
      <a href="#servicios" data-nav="servicios" class="text-on-surface-variant hover:text-primary transition-colors duration-200">Servicios</a>
      <a href="#abogados" data-nav="abogados" class="text-on-surface-variant hover:text-primary transition-colors duration-200">Abogados</a>
      <a href="#contacto" data-nav="contacto" class="text-on-surface-variant hover:text-primary transition-colors duration-200">Contacto</a>
    </nav>
    <MobileDrawer client:media="(max-width: 768px)" />
  </div>
</header>

<script>
  (() => {
    const header = document.getElementById('site-header');
    const sentinel = document.getElementById('header-sentinel');
    const navLinks = document.querySelectorAll('#desktop-nav [data-nav]');
    if (!header) return;

    const toggle = (scrolled: boolean) => header.classList.toggle('is-scrolled', scrolled);
    if (sentinel && 'IntersectionObserver' in window) {
      const obs = new IntersectionObserver(([e]) => toggle(!e.isIntersecting), { rootMargin: '-80px 0px 0px 0px' });
      obs.observe(sentinel);
    } else {
      const onScroll = () => toggle(window.scrollY > 64);
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    }

    const sections = ['inicio','nosotros','servicios','abogados','why-us','contacto'];
    const navMap: Record<string,string> = { 'why-us': 'contacto' };
    const sectionEls = sections.map(id => document.getElementById(id)).filter(Boolean) as HTMLElement[];
    if ('IntersectionObserver' in window && sectionEls.length) {
      const activeObs = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            const id = e.target.id;
            const navId = navMap[id] ?? id;
            navLinks.forEach(a => {
              const isActive = a.getAttribute('data-nav') === navId;
              a.classList.toggle('text-primary', isActive);
              a.classList.toggle('border-b-2', isActive);
              a.classList.toggle('border-primary', isActive);
              a.classList.toggle('font-semibold', isActive);
              if (isActive) a.setAttribute('aria-current','page'); else a.removeAttribute('aria-current');
            });
          }
        });
      }, { rootMargin: '-50% 0px -50% 0px', threshold: 0 });
      sectionEls.forEach(el => activeObs.observe(el));
    }
  })();
</script>
