---
import { Image } from "astro:assets";
import logo from "../assets/logo.webp";
---
<header id="site-header" class="fixed top-0 w-full z-50 bg-surface/80 backdrop-blur-md shadow-sm border-b border-outline-variant">
  <div class="max-w-[1200px] mx-auto flex justify-between items-center px-6 md:px-10 h-20">
    <a href="#inicio" class="flex items-center gap-2" aria-label="Ipial Abogados — Inicio">
      <Image src={logo} alt="Ipial Abogados" widths={[120, 200]} sizes="120px" format="webp" quality={80} loading="eager" class="h-11 w-auto object-contain" width={200} height={61} />
    </a>
    <nav class="hidden md:flex gap-6 items-center text-[15px]" aria-label="Navegación principal">
      <a href="#inicio" aria-current="page" class="text-primary border-b-2 border-primary pb-1 font-semibold">Inicio</a>
      <a href="#nosotros" class="text-on-surface-variant hover:text-primary transition-colors duration-200">Nosotros</a>
      <a href="#abogados" class="text-on-surface-variant hover:text-primary transition-colors duration-200">Abogados</a>
      <a href="#servicios" class="text-on-surface-variant hover:text-primary transition-colors duration-200">Servicios</a>
      <a href="#contacto" class="text-on-surface-variant hover:text-primary transition-colors duration-200">Contacto</a>
    </nav>
    <button id="mobile-menu-button" type="button" aria-expanded="false" aria-controls="mobile-drawer" aria-label="Abrir menú de navegación" class="md:hidden p-2 text-on-surface header-menu-icon focus-visible:outline-2 focus-visible:outline-emerald-deep focus-visible:outline-offset-2 rounded-sm">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
  </div>
  <div id="mobile-drawer" hidden class="md:hidden absolute top-full left-0 w-full bg-surface border-t border-outline-variant shadow-lg">
    <nav class="flex flex-col px-6 py-6 gap-4 text-[15px]" aria-label="Navegación móvil">
      <a href="#inicio" class="text-primary font-semibold py-2">Inicio</a>
      <a href="#nosotros" class="text-on-surface-variant hover:text-primary py-2">Nosotros</a>
      <a href="#abogados" class="text-on-surface-variant hover:text-primary py-2">Abogados</a>
      <a href="#servicios" class="text-on-surface-variant hover:text-primary py-2">Servicios</a>
      <a href="#contacto" class="text-on-surface-variant hover:text-primary py-2">Contacto</a>
    </nav>
  </div>
  <div id="mobile-overlay" hidden class="md:hidden fixed inset-0 top-20 bg-black/20 backdrop-blur-sm -z-10"></div>
</header>

<script>
  (() => {
    const header = document.getElementById('site-header');
    const sentinel = document.getElementById('header-sentinel');
    const btn = document.getElementById('mobile-menu-button');
    const drawer = document.getElementById('mobile-drawer');
    const overlay = document.getElementById('mobile-overlay');
    if (!header) return;

    const toggle = (scrolled: boolean) => header.classList.toggle('is-scrolled', scrolled);
    if (sentinel && 'IntersectionObserver' in window) {
      const obs = new IntersectionObserver(
        ([e]) => toggle(!e.isIntersecting),
        { rootMargin: '-80px 0px 0px 0px' }
      );
      obs.observe(sentinel);
    } else {
      const onScroll = () => toggle(window.scrollY > 64);
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    }

    if (btn && drawer) {
      const setOpen = (open: boolean) => {
        btn.setAttribute('aria-expanded', String(open));
        btn.setAttribute('aria-label', open ? 'Cerrar menú de navegación' : 'Abrir menú de navegación');
        if (open) {
          drawer.removeAttribute('hidden');
          overlay?.removeAttribute('hidden');
          document.body.style.overflow = 'hidden';
        } else {
          drawer.setAttribute('hidden', '');
          overlay?.setAttribute('hidden', '');
          document.body.style.overflow = '';
        }
      };
      btn.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') === 'true';
        setOpen(!open);
      });
      overlay?.addEventListener('click', () => setOpen(false));
      drawer.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
          setOpen(false);
          btn.focus();
        }
      });
    }
  })();
</script>
