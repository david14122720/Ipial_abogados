<section id="contacto" class="py-20 bg-white border-t border-[#bec9c4]/20">
  <div class="max-w-[1200px] mx-auto px-6 md:px-16">
    <div class="grid md:grid-cols-2 gap-12 md:gap-20">
      <div>
        <h2 class="text-[32px] leading-10 font-semibold text-[#1a1c1c] underline-motif" style="font-family:'Libre Caslon Text',serif">Contacto</h2>
        <ul class="space-y-6 mt-8">
          <li class="flex items-start gap-4">
            <span class="text-[#005243] mt-1"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s7-5 7-11a7 7 0 1 0-14 0c0 6 7 11 7 11z"/><circle cx="12" cy="10" r="3"/></svg></span>
            <div>
              <p class="text-sm font-semibold text-[#1a1c1c] tracking-wide">Dirección</p>
              <p class="text-[15px] text-[#5b5f61]">Cra 6 No. 2-36-Av. Las Lajas<br />Ipiales - Nariño</p>
            </div>
          </li>
          <li class="flex items-start gap-4">
            <span class="text-[#005243] mt-1"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07A19.5 19.5 0 0 1 5 12V9a2 2 0 0 1 2-2h3"/></svg></span>
