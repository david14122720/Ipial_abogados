              <p class="text-[15px] text-[#5b5f61]"><a href="https://wa.me/573188215030" class="hover:text-[#005243]">318 821 5030</a></p>
              <p class="text-[15px] text-[#5b5f61]"><a href="https://wa.me/573137664683" class="hover:text-[#005243]">313 766 4683</a></p>
            </div>
          </li>
          <li class="flex items-start gap-4">
            <span class="text-[#005243] mt-1"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg></span>
            <div>
              <p class="text-sm font-semibold text-[#1a1c1c] tracking-wide">Horario de Atención</p>
              <p class="text-[15px] text-[#5b5f61]">Lunes a Viernes: 8:00 AM - 6:00 PM</p>
