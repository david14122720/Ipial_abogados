        <a href="https://wa.me/573188215030" target="_blank" rel="noopener noreferrer" class="inline-flex mt-8 bg-[#005243] text-white px-8 py-3 rounded text-sm font-semibold hover:bg-[#1e6b5a] transition-colors">Escribir por WhatsApp</a>
      </div>
      <div class="w-full h-80 bg-[#eeeeed] rounded-lg border border-[#bec9c4]/30 flex items-center justify-center overflow-hidden">
        <div class="text-center p-6">
          <p class="text-[#5b5f61] text-sm">Mapa — Cra 6 No. 2-36, Ipiales, Nariño</p>
