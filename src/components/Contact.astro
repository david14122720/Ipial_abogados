---
import { CONTACT } from "../consts.ts";
---
<section class="py-section-padding px-gutter bg-surface-container-low" id="contacto">
  <div class="max-w-container-max mx-auto">
    <div data-reveal class="text-center mb-16">
      <h2 class="font-headline-lg text-headline-lg text-on-surface mb-4">Ubicación y Contacto</h2>
      <div class="w-16 h-px bg-platinum-silver mx-auto"></div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-16 items-start md:items-center">
      <div data-reveal class="w-full h-64 sm:h-72 md:h-80 bg-surface-container rounded-lg overflow-hidden relative border border-outline-variant order-2 md:order-1">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3989.784645454545!2d-77.64!3d0.82!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMMKwNDknMTIuMCJOIDc3wrAzOCcyNC4wIlc!5e0!3m2!1ses!2sco!4v1700000000000!5m2!1ses!2sco"
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="grayscale contrast-125"
          title="Mapa Ipial Abogados — Cra 6 No. 2-36-Av. Las Lajas, Ipiales"
        ></iframe>
      </div>
      <div class="flex flex-col gap-6 md:gap-8 order-1 md:order-2">
        <div data-reveal>
          <h3 class="font-headline-md text-headline-md text-on-surface mb-4">Encuéntranos</h3>
          <p class="text-body-md text-charcoal-text mb-6">Estamos ubicados en el corazón de Ipiales, listos para brindarle la mejor asesoría jurídica.</p>
          <div class="space-y-4">
            <div class="flex items-center gap-4">
              <span class="material-symbols-outlined text-teal-accent" aria-hidden="true">location_on</span>
              <span class="text-body-md">Cra 6 No. 2-36-Av. Las Lajas, Ipiales - Nariño</span>
            </div>
            <div class="flex items-center gap-4">
              <span class="material-symbols-outlined text-teal-accent" aria-hidden="true">phone_iphone</span>
              <span class="text-body-md">+57 318 821 5030 / 313 766 4683</span>
            </div>
          </div>
        </div>
        <div data-reveal data-reveal-delay="100" class="flex flex-col gap-4">
          <h4 class="font-label-md text-label-md uppercase tracking-wider text-secondary">Síguenos en Redes</h4>
          <div class="flex gap-4">
            <a href="https://www.facebook.com/" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="social-lift w-12 h-12 rounded-full bg-surface-container-high text-text-on-dark flex items-center justify-center hover:bg-teal-accent transition-colors">
              <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"></path></svg>
            </a>
            <a href="https://www.instagram.com/" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="social-lift w-12 h-12 rounded-full bg-surface-container-high text-text-on-dark flex items-center justify-center hover:bg-teal-accent transition-colors">
              <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"></path></svg>
            </a>
          </div>
        </div>
        <a data-reveal data-reveal-delay="200" class="social-lift inline-flex items-center justify-center gap-2 bg-teal-accent text-white px-8 py-4 rounded-lg font-label-md uppercase tracking-widest hover:bg-teal-accent hover:text-forest-deep transition-all border border-transparent hover:border-teal-accent w-fit" href={CONTACT.waPrimaryHref} target="_blank" rel="noopener noreferrer">
          <span class="material-symbols-outlined" aria-hidden="true">chat</span>
          Contáctanos por WhatsApp
        </a>
      </div>
    </div>
  </div>
</section>
