---
import { CONTACT } from "../consts.ts";
---
<section id="contacto" class="py-20 bg-surface border-t border-platinum-silver">
  <div class="max-w-[1200px] mx-auto px-6 md:px-16">
    <div class="grid md:grid-cols-2 gap-12 md:gap-20">
      <div>
        <h2 class="text-[32px] leading-10 font-semibold text-on-surface underline-motif">Contacto</h2>
        <ul class="space-y-6 mt-8">
          <li class="flex items-start gap-4">
            <span class="text-primary mt-1"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s7-5 7-11a7 7 0 1 0-14 0c0 6 7 11 7 11z"/><circle cx="12" cy="10" r="3"/></svg></span>
            <div>
              <p class="text-sm font-semibold text-on-surface tracking-wide">Dirección</p>
              <p class="text-[15px] text-secondary">{CONTACT.address.full}</p>
            </div>
          </li>
          <li class="flex items-start gap-4">
            <span class="text-primary mt-1"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07A19.5 19.5 0 0 1 5 12V9a2 2 0 0 1 2-2h3"/></svg></span>
            <div>
              <p class="text-sm font-semibold text-on-surface tracking-wide">Líneas de Atención (WhatsApp)</p>
              <p class="text-[15px] text-secondary"><a href={CONTACT.waPrimaryHref} target="_blank" rel="noopener noreferrer" aria-label={`Contactar por WhatsApp al ${CONTACT.whatsappPrimary}`} class="hover:text-primary transition-colors duration-200">{CONTACT.displayPrimary}</a></p>
              <p class="text-[15px] text-secondary"><a href={CONTACT.waSecondaryHref} target="_blank" rel="noopener noreferrer" aria-label={`Contactar por WhatsApp al ${CONTACT.whatsappSecondary}`} class="hover:text-primary transition-colors duration-200">{CONTACT.displaySecondary}</a></p>
            </div>
          </li>
          <li class="flex items-start gap-4">
            <span class="text-primary mt-1"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg></span>
            <div>
              <p class="text-sm font-semibold text-on-surface tracking-wide">Horario de Atención</p>
              <p class="text-[15px] text-secondary">{CONTACT.horario}</p>
            </div>
          </li>
        </ul>
        <a href={CONTACT.waPrimaryHref} target="_blank" rel="noopener noreferrer" aria-label="Contactar por WhatsApp" class="inline-flex mt-8 bg-primary text-white px-8 py-3 rounded-sm text-sm font-semibold hover:bg-primary-container transition-colors duration-200">Escribir por WhatsApp</a>
      </div>
      <div data-map="placeholder" class="w-full h-80 bg-surface-container-low rounded-sm border border-platinum-silver flex items-center justify-center overflow-hidden">
        <div class="text-center p-6">
          <p class="text-secondary text-sm">Mapa — {CONTACT.address.street}, {CONTACT.address.city}, {CONTACT.address.region}</p>
          <p class="text-xs text-outline mt-2">Integración de mapa disponible al configurar ubicación exacta</p>
        </div>
      </div>
    </div>
  </div>
</section>
