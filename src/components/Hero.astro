---
import { Image } from "astro:assets";
import principal from "../assets/principal.webp";
import logo from "../assets/logo.webp";
import { CONTACT } from "../consts.ts";
---
<section id="inicio" class="relative min-h-[78vh] flex items-center justify-center overflow-hidden">
  <div class="absolute inset-0" aria-hidden="true">
    <Image
      src={principal}
      alt=""
      widths={[640, 960, 1280]}
      sizes="100vw"
      format="webp"
      quality={75}
      loading="eager"
      fetchpriority="high"
      class="w-full h-full object-cover object-center"
    />
    <div class="absolute inset-0" style="background: rgba(0,0,0,0.5)"></div>
  </div>
  <div class="relative z-10 max-w-container-max mx-auto px-gutter py-12 md:py-20 flex flex-col items-center text-center w-full">
    <div class="h-32 w-32 rounded-full overflow-hidden shadow-sm bg-surface-container-lowest flex-shrink-0 mb-6">
      <Image
        src={logo}
        alt="Ipial Abogados"
        widths={[128, 256]}
        sizes="128px"
        format="webp"
        quality={80}
        loading="eager"
        class="w-full h-full object-cover"
      />
    </div>
    <h1 class="text-headline-xl text-white mb-6 max-w-4xl" style="font-family:'Libre Caslon Text',serif;">Autoridad, Precisión y Legado</h1>
    <p class="text-body-lg text-white max-w-2xl mb-8 opacity-95">
      Asesoría legal especializada para brindarte la tranquilidad y seguridad que mereces, fundamentada en la integridad y el rigor profesional.
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href={CONTACT.waPrimaryHref}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-emerald-deep text-white px-8 py-3 rounded-full text-sm font-semibold hover:opacity-90 transition-opacity duration-200 text-center focus-visible:outline-2 focus-visible:outline-white focus-visible:outline-offset-2"
        >Contactar por WhatsApp</a
      >
      <a
        href="#servicios"
        class="bg-white/10 backdrop-blur-sm border border-white/30 text-white px-8 py-3 rounded-full text-sm font-semibold hover:bg-white/20 transition-colors duration-200 text-center focus-visible:outline-2 focus-visible:outline-white focus-visible:outline-offset-2"
        >Nuestros Servicios</a
      >
    </div>
  </div>
  <div id="header-sentinel" aria-hidden="true" class="h-px w-full absolute bottom-0 left-0"></div>
</section>
