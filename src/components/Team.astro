---
import { Image } from "astro:assets";
import omarImg from "../assets/principal.webp";
---
<section class="py-section-padding px-gutter bg-surface border-t border-outline-variant" id="abogados">
  <div class="max-w-container-max mx-auto">
    <div data-reveal class="text-center mb-16">
      <h2 class="font-headline-lg text-headline-lg text-on-surface mb-4">Nuestros Abogados</h2>
      <div class="w-16 h-px bg-platinum-silver mx-auto"></div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-16">
      <div data-reveal class="flex flex-col items-center text-center px-2">
        <div class="w-48 h-48 md:w-56 md:h-56 rounded-full overflow-hidden border-4 border-surface-container-low mb-5 md:mb-6 shrink-0">
          <Image src={omarImg} alt="Omar Enrique Ipial Ipial" widths={[160, 192, 384]} sizes="(max-width: 768px) 160px, 192px" format="webp" quality={75} loading="lazy" class="w-full h-full object-cover" />
        </div>
        <h3 class="font-headline-md text-headline-md text-on-surface mb-2 [text-wrap:balance]">Omar Enrique Ipial Ipial</h3>
        <p class="font-label-md text-label-md text-teal-accent-light uppercase tracking-wider mb-3 md:mb-4 [text-wrap:balance]">Especialista en Derecho Laboral y Seguridad Social</p>
      </div>
      <div data-reveal data-reveal-delay="150" class="flex flex-col items-center text-center px-2">
        <div class="w-48 h-48 md:w-56 md:h-56 rounded-full overflow-hidden border-4 border-surface-container-high mb-5 md:mb-6 shrink-0 bg-surface-container-lowest flex items-center justify-center" aria-hidden="true">
          <span class="font-serif font-bold text-teal-accent-light text-4xl md:text-5xl tracking-[0.08em] select-none">FM</span>
        </div>
        <h3 class="font-headline-md text-headline-md text-on-surface mb-2 [text-wrap:balance]">Franco Miller Ipial Ipial</h3>
        <p class="font-label-md text-label-md text-teal-accent-light uppercase tracking-wider mb-3 md:mb-4 [text-wrap:balance]">Especialista en Derecho Penal y Procesal Penal</p>
      </div>
    </div>
  </div>
</section>
