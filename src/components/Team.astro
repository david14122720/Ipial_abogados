---
import { Image } from "astro:assets";
import principal from "../assets/principal.webp";
import { CONTACT } from "../consts.ts";
// Fuente: Ipialabogados.md §2 — verbatim §6. Nombres y especialidades exactos, sin bios inventadas.
---
<section id="abogados" class="py-section-gap px-gutter bg-surface">
  <div class="max-w-container-max mx-auto">
    <div class="text-center">
      <h2 class="text-headline-lg text-primary">Nuestro Equipo</h2>
    </div>
    <div class="grid md:grid-cols-2 gap-8 mt-10 max-w-4xl mx-auto">
      <div class="flex flex-col items-center text-center p-6">
        <div class="w-64 h-64 rounded-full overflow-hidden shadow-md bg-surface-container-low flex-shrink-0">
          <Image src={principal} alt="Omar Enrique Ipial Ipial" widths={[256, 512]} sizes="256px" format="webp" quality={75} loading="lazy" class="w-full h-full object-cover" />
        </div>
        <h3 class="text-headline-md text-primary mt-6">Omar Enrique Ipial Ipial</h3>
        <p class="text-body-md text-primary mt-1">Especialista en Derecho Laboral y Seguridad Social</p>
        <a href={CONTACT.waPrimaryHref} target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex items-center gap-2 bg-whatsapp-green text-white px-5 py-2 rounded-full text-sm font-semibold hover:opacity-90 transition-opacity focus-visible:outline-2 focus-visible:outline-emerald-deep focus-visible:outline-offset-2">WhatsApp</a>
      </div>
      <div class="flex flex-col items-center text-center p-6">
        <div class="w-64 h-64 rounded-full overflow-hidden shadow-md bg-surface-container-low flex-shrink-0">
          <Image src={principal} alt="Franco Miller Ipial Ipial" widths={[256, 512]} sizes="256px" format="webp" quality={75} loading="lazy" class="w-full h-full object-cover" />
        </div>
        <h3 class="text-headline-md text-primary mt-6">Franco Miller Ipial Ipial</h3>
        <p class="text-body-md text-primary mt-1">Especialista en Derecho Penal y Procesal Penal</p>
        <a href={CONTACT.waPrimaryHref} target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex items-center gap-2 bg-whatsapp-green text-white px-5 py-2 rounded-full text-sm font-semibold hover:opacity-90 transition-opacity focus-visible:outline-2 focus-visible:outline-emerald-deep focus-visible:outline-offset-2">WhatsApp</a>
      </div>
    </div>
  </div>
</section>
